    <!-- Resources / Collision -->
    <string name="collision_tool_name">Колізія R.string</string>
    <string name="collision_desc">Значення R.string плагіну мають пріоритет над однойменними рядками хосту.</string>
    <string name="collision_apis">CompositionFallbackContext, FallbackResources (внутрішній — прозорий для авторів плагінів)</string>
    <string name="settings">Налаштування плагіна</string>
    <string name="collision_explainer">І застосунок-хост, і цей плагін оголошують рядок з назвою settings. Кожен компілюється у власний ID у власному APK. Ось яке значення перемагає, коли плагін читає R.string.settings:</string>
    <string name="collision_host_label">Хост (c4ds) оголошує</string>
    <string name="collision_host_value">Налаштування</string>
    <string name="collision_plugin_label">Цей плагін оголошує</string>
    <string name="collision_resolved_label">Вирішується у</string>
    <string name="collision_resolved_badge">перемагає плагін</string>
    <string name="collision_plugin_first_caption">Плагін навіть не може прочитати значення хосту під час виконання — ізоляція між APK відгороджує його, тож рядок вище наведено лише для довідки. Саме ця межа й працює на ваших очах.</string>

