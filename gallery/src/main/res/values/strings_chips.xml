<resources>
    <!-- UI Components Catalog — Chips field showcase -->
    <string name="ui_catalog_chips_field_name">Chips field</string>
    <string name="ui_catalog_chips_field_desc">ChipsField, ChipAutocompleteList, AutoCompleteTextFieldBox, ChipValue, Chip and AllChipsDialog. The field is stateless: the caller owns the query and the selection.</string>

    <string name="chips_basic_name">Basic selection</string>
    <string name="chips_basic_desc">ChipsField with ChipAutocompleteList inside AutoCompleteTextFieldBox. Focus the field and type to filter the options, tap an option to add it, tap a chip to remove it. Backspace on an empty input outlines the last chip; a second Backspace removes it.</string>
    <string name="chips_create_name">Create a new item</string>
    <string name="chips_create_desc">Type a tag that is not in the list: the first row offers to create it. Tap the row or use the keyboard action. A created tag is offered again after you remove it.</string>
    <string name="chips_states_name">Chip states</string>
    <string name="chips_states_desc">Status dots, a leading icon, a chip that cannot be removed (lock icon) and a disabled chip — tap either for an explanation. The options show a description, a time and a role; one option is listed but cannot be picked, and one has no name.</string>
    <string name="chips_field_states_name">Field states</string>
    <string name="chips_field_states_desc">Switch the read-only, enabled, error and loading states of a live field and its end content. The list shows a custom message when nothing matches.</string>
    <string name="chips_overflow_name">More than 10 chips</string>
    <string name="chips_overflow_desc">Only the first 10 chips are drawn; the rest hide behind a \"+N\" chip that opens AllChipsDialog. The button opens the same dialog directly.</string>
    <string name="chips_standalone_name">Standalone Chip</string>
    <string name="chips_standalone_desc">The Chip composable outside a field: enabled, disabled and highlighted, with a status dot, and with leading and trailing icons.</string>

